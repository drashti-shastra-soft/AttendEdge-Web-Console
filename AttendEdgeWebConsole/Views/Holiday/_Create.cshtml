@model AttendEdgeWebConsole.Domain.Holiday

<div class="modal fade" id="modal-holiday" tabindex="-1" aria-labelledby="HolidayModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">

                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="HolidayModalLabel">Edit Holiday</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="HolidayModalLabel">Add Holiday</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                @Html.HiddenFor(m => m.Id)

                @if (ViewBag.ShowCompany)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <label> Company </label>
                            @Html.DropDownListFor(m => m.CompanyId, ViewBag.Companies as List<SelectListItem>, "Select Company", new { @class = "form-control" })
                        </div>
                    </div>
                }
                <div class="row mb-2">
                    <div class="col">
                        <label>Name <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>Date <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.Date, new { @class = "form-control", @type = "date", placeholder = "Enter Date" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label> Description <span class="text-danger"></span></label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", placeholder = "Enter Description", rows = "4" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                            <label class="form-check-label" for="isActiveCheck">Is Active?</label>
                        </div>
                    </div>

                </div>
                <div class="row mb-2">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsHalfDay, new { @class = "form-check-input" })
                            <label class="form-check-label" for="isHalfCheck">Is Half Day</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>
            </div>
        </div>
    </div>
</div>


@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)

<script src="@Url.Content("~/custom-js/holiday/create.js")"></script>
<script>
    $(document).ready(function () {
        var today = new Date().toISOString().split('T')[0];
        $('input[name="Date"]').val(today);
    });
</script>
