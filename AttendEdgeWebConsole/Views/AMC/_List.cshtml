@model AttendEdgeWebConsole.Domain.AMCLister
<div class="card-header">
    <a href="javascript:void(0)" class="btn btn-primary add-contract float-right">Add Contract</a>
</div>
<div class="card-body">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                @if (ViewBag.ShowCompany)
                {
                    <th>
                        Company
                    </th>
                }
                <th>Name</th>
                <th>Contact Person</th>
                <th>Mobile</th>
                <th>Service Covered</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th class="text-center">
                    Status
                </th>
                <th colspan="2" class="text-center">Actions</th>
            </tr>
            <tr>
                @if (ViewBag.ShowCompany)
                {
                    <th>
                        @Html.DropDownListFor(m => m.SearchCriteria.CompanyId, ViewBag.Companies as List<SelectListItem>, "Select Company", new { @class = "form-control search-dropdown" })
                    </th>
                }
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.Name, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.ContactPerson, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.MobileNumber, new { @class = "form-control search-text" })
                </th>
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.ServicesCovered, new { @class = "form-control search-text" })
                </th>
                <th>
                    @*@Html.TextBoxFor(m => m.SearchCriteria.ContractStartDate, new { @class = "form-control search-text clear-default-date-time" })*@
                </th>
                <th>
                    @*@Html.TextBoxFor(m => m.SearchCriteria.ContractEndDate, new { @class = "form-control search-text clear-default-date-time" })*@
                </th>
                <th>
                    @Html.DropDownListFor(m => m.SearchCriteria.Status, ViewBag.Status as List<SelectListItem>, "Select Status", new { @class = "form-control search-dropdown" })
                </th>
                <th class="text-center"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.List != null && Model.List.Count > default(int))
            {
                foreach (var item in Model.List)
                {
                    <tr>
                        @if (ViewBag.ShowCompany)
                        {
                            <td>@item.Company</td>
                        }
                        <td>@item.Name</td>


                        <td>@item.ContactPerson</td>
                        <td>@item.MobileNumber</td>
                        <td>@item.ServicesCovered</td>
                        <td>@item.ContractStartDate.ToString("dd-MM-yyyy")</td>
                        <td>@item.ContractEndDate.ToString("dd-MM-yyyy")</td>
                        <td class="text-center">
                            @if (item.IsActive)
                            {
                                <span class="badge badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">Disabled</span>
                            }
                        </td>
                        <td class="text-center">
                            <a href="javascript:void(0);" data-id="@item.Id" class="btn-edit text-info"><i class="fas fa-edit"></i></a>
                        </td>

                        <td class="text-center">
                            <a href="javascript:void(0);" data-id="@item.Id" class="icon-delete text-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="9">
                        There is currently no content to display
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<!-- /.card-body -->
<div class="card-footer">
    <div class="row">
        <div class="col-12">
            <div class="row footer-button-section">
                <div class="col-lg-3 col-xl-3">
                    <div class="page-per-size d-flex align-items-center">
                        @Html.DropDownListFor(m => m.Pagination.PageSize, ViewBag.Pagination as List<SelectListItem> ?? new List<SelectListItem>(), new { @class = "form-control search-pagination set-page-size" })
                        <label>entries per page</label>
                    </div>
                </div>
                <style>
                </style>
                <div class="col-lg-4 offset-xl-1 col-xl-3 d-flex justify-content-center align-items-center">
                    <div class="showing-entry d-flex align-items-center">
                        <h3>@Model.Pagination.PaginationSummary </h3>
                    </div>
                </div>
                <div class="col-lg-5 col-xl-5">
                    <div class="navigation-tab">
                        <input type="button" value="First" class="btn btn-secondary navigation" data-direction="First" />
                        <input type="button" value="Previous" class="btn btn-secondary navigation" data-direction="Previous" />
                        <label> @Model.Pagination.CurrentPage / @Model.Pagination.TotalPage</label>
                        <input type="button" value="Next" class="btn btn-secondary navigation" data-direction="Next" />
                        <input type="button" value="Last" class="btn btn-secondary navigation" data-direction="Last" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.Pagination.Skip)
    @Html.HiddenFor(m => m.Pagination.TotalRecord)

</div>
<!-- /.card-footer-->

<script src="@Url.Content("~/custom-js/amc/list.js")"></script>

<script type="text/javascript">
    $(document).ready(function () {
        if ($('.clear-default-date-time').val() == '01-01-0001 00:00:00' || $('.clear-default-date-time').val() == '1-1-0001 00:00:00') {
            $('.clear-default-date-time').val('');
        }
    });

    window.paginationConfig = {
    pageSize: @Model.Pagination.PageSize,
    totalPage: @Model.Pagination.TotalPage,
    currentPage: @Model.Pagination.CurrentPage,
    skip: @Model.Pagination.Skip,
    };
</script>
