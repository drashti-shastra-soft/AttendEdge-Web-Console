@model AttendEdgeWebConsole.Domain.LeaveRequest

<div class="modal fade" id="modal-LeaveRequest" tabindex="-1" aria-labelledby="LeaveRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                @if (Model.Id > 0)
                {
                    <h5 class="modal-title fs-5" id="LeaveRequestModalLabel">Edit Leave Request</h5>
                }
                else
                {
                    <h5 class="modal-title fs-5" id="LeaveRequestModalLabel">Add Leave Request</h5>
                }
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.CompanyId)
                @Html.HiddenFor(m => m.UserId)

                <div class="row mb-2">
                    @if ((bool?)ViewBag.ShowUser == true)
                    { 
                        <div class="col">
                            <label>User <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.UserId, ViewBag.Users as List<SelectListItem>, "Select Employee", new { @class = "form-control" })
                            <span class="text-danger"></span>
                        </div>
                    }

                    <div class="col">
                        <label>Leave Type<span class="text-danger">*</span></label><br />
                        @Html.DropDownListFor(m => m.LeaveType, ViewBag.LeaveTypes as List<SelectListItem>, "Select Leave Type", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Start Date <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        <span class="text-danger"></span>
                    </div>
                    <div class="col">
                        <label>End Date <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2" style="align-items: center">
                    <div class="col">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.IsHalfDay, new { @class = "form-check-input" })
                            <label class="form-check-label" for="IsHalfDay">Is Half Day?</label>
                        </div>
                    </div>
                    <div class="col" style="display:none;">
                        <label>Half Typec</label>
                        @Html.DropDownList("HalfType", ViewBag.HalfType as List<SelectListItem>, "Select Half Type", new { @class = "form-control" })
                        <span class="text-danger"></span>
                    </div>
                </div>

                <div class="row mb-2">
                    <div class="col">
                        <label>Reason <span class="text-danger">*</span></label>
                        @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", placeholder = "Enter Reason", rows = "5" })
                        <span class="text-danger"></span>
                    </div>
                </div>
                <div class="row mb-2">
                    @if ((bool?)ViewBag.ShowAdminNote == true)
                    {
                        <div class="col">
                            <label>Admin Note</label>
                            @Html.TextAreaFor(m => m.AdminNote, new { @class = "form-control", placeholder = "Enter Admin Note", rows = "5" })
                        </div>
                    }
                </div>

                <div class="row mb-2">
                    @if ((bool?)ViewBag.ShowStatus == true)
                    {
                        <div class="col-6">
                            <label>Status <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.Status, ViewBag.LeaveStatus as List<SelectListItem>, "Select Status", new { @class = "form-control" })
                            <span class="text-danger"></span>
                        </div>
                    }
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <a href="javascript:void(0);" class="btn btn-primary btn-submit">Submit</a>

            </div>
        </div>
    </div>
</div>

@Html.Hidden("NotificationType", (object)ViewBag.NotificationType)
@Html.Hidden("NotificationMsg", (object)ViewBag.NotificationMsg)

<script src="@Url.Content("~/custom-js/leaveRequest/create.js")"></script>
