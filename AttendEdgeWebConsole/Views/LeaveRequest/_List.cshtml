@model AttendEdgeWebConsole.Domain.LeaveRequestLister

<div class="card-header">
    <a href="javascript:void(0)" class="btn btn-primary add-LeaveRequest float-right">Add Leave Request</a>
</div>
<div class="card-body">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                @if ((bool?)ViewBag.ShowUser == true)
                {
                    <th>Employee</th>
                }
                <th>Leave Type</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Half Type</th>
                @if ((bool?)ViewBag.ShowStatus == true)
                {
                    <th class="text-center">Status</th>
                }
                <th colspan="2" class="text-center">Action</th>
            </tr>
            <tr>
                @if ((bool?)ViewBag.ShowUser == true)
                {
                    <th>
                        @Html.TextBoxFor(m => m.SearchCriteria.Username, new { @class = "form-control search-text" })
                    </th>
                }
                <th>
                    @Html.TextBoxFor(m => m.SearchCriteria.LeaveType, new { @class = "form-control search-text" })
                </th>
                <th>
                    @*@Html.TextBoxFor(m => m.SearchCriteria.StartDate, new { @class = "form-control search-text clear-default-date-time" })*@
                </th>
                <th>
                    @*@Html.TextBoxFor(m => m.SearchCriteria.EndDate, new { @class = "form-control search-text clear-default-date-time" })*@
                </th>
                <th>
                    @Html.DropDownListFor(m => m.SearchCriteria.HalfType, ViewBag.HalfType as List<SelectListItem>, "Select Half Type", new { @class = "form-control search-dropdown" })
                </th>
                @if ((bool?)ViewBag.ShowStatus == true)
                {
                    <th>
                        @Html.TextBoxFor(m => m.SearchCriteria.Status, new { @class = "form-control search-text" })
                    </th>
                }
                <th colspan="2" class="text-center"></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.List != null && Model.List.Count > default(int))
            {
                foreach (var item in Model.List)
                {


                    <tr>
                        @if ((bool?)ViewBag.ShowUser == true)
                        {
                            <td>@item.Username</td>
                        }
                        <td>@item.LeaveType</td>
                        <td>@item.StartDate.ToString("dd-MM-yyyy")</td>
                        <td>@item.EndDate.ToString("dd-MM-yyyy")</td>
                        <td class="text-center">
                            @if (item.IsHalfDay)
                            {
                                var halfLabel = item.HalfType == "First Half" ? "First Half" : "Second Half";
                                <span class="badge badge-warning">@halfLabel</span>
                            }
                            else
                            {
                                <span class="badge badge-secondary">Full Day</span>
                            }
                        </td>
                        @if ((bool?)ViewBag.ShowStatus == true)
                        {
                            <td class="text-center">
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge badge-warning">Pending</span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge badge-success">Approved</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge badge-danger">Rejected</span>
                                }
                            </td>
                        }
                        <td class="text-center">
                                <a href="javascript:void(0);" data-id="@item.Id" class="btn-edit text-info"><i class="fas fa-edit"></i></a>
                            </td>

                            <td class="text-center">
                                <a href="javascript:void(0);" data-id="@item.Id" class="icon-delete text-danger"><i class="fas fa-trash"></i></a>
                            </td>
                        @*<td class="text-center">
                            @if (item.Status == "Pending" && !(bool)ViewBag.IsEmployee)
                            {
                                <a href="javascript:void(0);" data-id="@item.Id" class="btn-edit text-info">
                                    <i class="fas fa-edit"></i>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted"><i class="fas fa-edit"></i></span>
                            }
                        </td>

                        <td class="text-center">
                            @if (item.Status == "Pending" && !(bool)ViewBag.IsEmployee)
                            {
                                <a href="javascript:void(0);" data-id="@item.Id" class="icon-delete text-danger">
                                    <i class="fas fa-trash"></i>
                                </a>
                            }
                            else
                            {
                                <span class="text-muted"><i class="fas fa-trash"></i></span>
                            }
                        </td>*@
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td class="text-center text-danger" colspan="9">
                        There is currently no content to display
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>
<!-- /.card-body -->
<div class="card-footer">
    <div class="row">
        <div class="col-12">
            <div class="row footer-button-section">
                <div class="col-lg-3 col-xl-3">
                    <div class="page-per-size d-flex align-items-center">
                        @Html.DropDownListFor(m => m.Pagination.PageSize, ViewBag.Pagination as List<SelectListItem> ?? new List<SelectListItem>(), new { @class = "form-control search-pagination set-page-size" })
                        <label>entries per page</label>
                    </div>
                </div>
                <style>
                </style>
                <div class="col-lg-4 offset-xl-1 col-xl-3 d-flex justify-content-center align-items-center">
                    <div class="showing-entry d-flex align-items-center">
                        <h3>@Model.Pagination.PaginationSummary </h3>
                    </div>
                </div>
                <div class="col-lg-5 col-xl-5">
                    <div class="navigation-tab">
                        <input type="button" value="First" class="btn btn-secondary navigation" data-direction="First" />
                        <input type="button" value="Previous" class="btn btn-secondary navigation" data-direction="Previous" />
                        <label> @Model.Pagination.CurrentPage / @Model.Pagination.TotalPage</label>
                        <input type="button" value="Next" class="btn btn-secondary navigation" data-direction="Next" />
                        <input type="button" value="Last" class="btn btn-secondary navigation" data-direction="Last" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.Pagination.Skip)
    @Html.HiddenFor(m => m.Pagination.TotalRecord)

</div>
<!-- /.card-footer-->

<script src="@Url.Content("~/custom-js/leaveRequest/list.js")"></script>
<script>
    $(document).ready(function () {
        if ($('.clear-default-date-time').val() == '01-01-0001 00:00:00' || $('.clear-default-date-time').val() == '1-1-0001 00:00:00') {
            $('.clear-default-date-time').val('');
        }
    });

 window.paginationConfig = {
    pageSize: @Model.Pagination.PageSize,
    totalPage: @Model.Pagination.TotalPage,
    currentPage: @Model.Pagination.CurrentPage,
    skip: @Model.Pagination.Skip,
   };
</script>
